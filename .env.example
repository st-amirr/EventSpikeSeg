# Copy this file to .env and use an absolute host path.
# Windows example: C:/Users/your-name/Desktop/Dataset
# macOS example: /Users/your-name/Documents/Dataset
MEVDT_HOST_ROOT=/absolute/path/to/MEVDT

# Reproducible long-run defaults. Override per command if needed.
TRAIN_SEED=101
TRAIN_SAMPLES=4096
TRAIN_WINDOW_STEPS=50
TRAIN_CHECKPOINT=mevdt_seed101_scale32_4096.pt
DOCKER_PLATFORM=linux/amd64
